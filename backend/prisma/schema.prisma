datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique @db.VarChar(50)
  descripcion String?        @db.Text
  created_at  DateTime       @default(now()) @db.Timestamptz
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz
  usuarios    UsuarioRole[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Usuario {
  id                   Int                    @id @default(autoincrement())
  username             String                 @unique @db.VarChar(50)
  password_hash        String                 @db.VarChar(255)
  nombre               String                 @db.VarChar(100)
  email                String?                @unique @db.VarChar(100)
  activo               Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz
  roles                UsuarioRole[]
  cuentas              Cuenta[]
  movimientosInventario MovimientoInventario[]
  turnos               Turno[]

  @@map("usuarios")
}

model UsuarioRole {
  usuario_id Int
  role_id    Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  role       Role    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, role_id])
  @@map("usuario_roles")
}

model Permiso {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique @db.VarChar(50)
  descripcion String?       @db.Text
  created_at  DateTime      @default(now()) @db.Timestamptz
  roles       RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  role_id    Int
  permiso_id Int
  role       Role    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permiso    Permiso @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  @@id([role_id, permiso_id])
  @@map("rol_permisos")
}

model Area {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @unique @db.VarChar(50)
  descripcion          String?                @db.Text
  activo               Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz
  inventarios          InventarioArea[]
  movimientosInventario MovimientoInventario[]
  cuentas              Cuenta[]

  @@map("areas")
}

model Producto {
  id                   Int                    @id @default(autoincrement())
  codigo_barras        String?                @unique @db.VarChar(50)
  nombre               String                 @db.VarChar(100)
  descripcion          String?                @db.Text
  precio_venta         Decimal                @db.Decimal(12, 4)
  categoria            String?                @db.VarChar(50)
  activo               Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz
  inventarios          InventarioArea[]
  movimientosInventario MovimientoInventario[]
  detalleCuentas       DetalleCuenta[]
  recetas              RecetaIngrediente[]

  @@map("productos")
}

model InventarioArea {
  area_id           Int
  producto_id       Int
  stock             Decimal  @default(0.0000) @db.Decimal(12, 4)
  stock_minimo      Decimal  @default(0.0000) @db.Decimal(12, 4)
  stock_maximo      Decimal  @default(0.0000) @db.Decimal(12, 4)
  ubicacion_estante String?  @db.VarChar(50)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz
  area              Area     @relation(fields: [area_id], references: [id], onDelete: Restrict)
  producto          Producto @relation(fields: [producto_id], references: [id], onDelete: Restrict)

  @@id([area_id, producto_id])
  @@map("inventario_areas")
}

model MovimientoInventario {
  id             BigInt   @id @default(autoincrement())
  area_id        Int
  producto_id    Int
  tipo_movimiento String   @db.VarChar(20)
  cantidad       Decimal  @db.Decimal(12, 4)
  stock_anterior Decimal  @db.Decimal(12, 4)
  stock_nuevo    Decimal  @db.Decimal(12, 4)
  usuario_id     Int
  referencia_id  String?  @db.VarChar(100)
  motivo         String?  @db.Text
  fecha          DateTime @default(now()) @db.Timestamptz
  area           Area     @relation(fields: [area_id], references: [id], onDelete: Restrict)
  producto       Producto @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  usuario        Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  @@map("movimientos_inventario")
}

model Cliente {
  id              Int                      @id @default(autoincrement())
  codigo_socio    String?                  @unique @db.VarChar(50)
  nombre          String                   @db.VarChar(100)
  email           String?                  @unique @db.VarChar(100)
  password_hash   String?                  @db.VarChar(255)
  telefono        String?                  @db.VarChar(20)
  qr_token        String?                  @unique @db.VarChar(255)
  activo          Boolean                  @default(true)
  created_at      DateTime                 @default(now()) @db.Timestamptz
  updated_at      DateTime                 @default(now()) @updatedAt @db.Timestamptz
  asignaciones    AsignacionCadiCliente[]
  divisionesCuentas DivisionCuenta[]
  cuentas         Cuenta[]

  @@map("clientes")
}

model Cadi {
  id           Int                      @id @default(autoincrement())
  numero_cadi  String                   @unique @db.VarChar(20)
  nombre       String                   @db.VarChar(100)
  telefono     String?                  @db.VarChar(20)
  estado       String                   @default("DISPONIBLE") @db.VarChar(20)
  created_at   DateTime                 @default(now()) @db.Timestamptz
  updated_at   DateTime                 @default(now()) @updatedAt @db.Timestamptz
  asignaciones AsignacionCadiCliente[]
  cuentas      Cuenta[]

  @@map("cadis")
}

model AsignacionCadiCliente {
  id           Int       @id @default(autoincrement())
  cadi_id      Int
  cliente_id   Int
  fecha_inicio DateTime  @default(now()) @db.Timestamptz
  fecha_fin    DateTime? @db.Timestamptz
  activa       Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz
  cadi         Cadi      @relation(fields: [cadi_id], references: [id], onDelete: Restrict)
  cliente      Cliente   @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cadi_id, cliente_id, activa], name: "uq_asignacion_activa")
  @@map("asignaciones_cadi_clientes")
}

model Cuenta {
  id                BigInt          @id @default(autoincrement())
  area_id           Int
  usuario_id        Int
  cadi_id           Int?
  cliente_id        Int?
  nombre_referencia String?         @db.VarChar(100)
  estado            String          @default("ABIERTA") @db.VarChar(20)
  subtotal          Decimal         @default(0.0000) @db.Decimal(12, 4)
  impuestos         Decimal         @default(0.0000) @db.Decimal(12, 4)
  descuento         Decimal         @default(0.0000) @db.Decimal(12, 4)
  total             Decimal         @default(0.0000) @db.Decimal(12, 4)
  metodo_pago       String?         @db.VarChar(50)
  created_at        DateTime        @default(now()) @db.Timestamptz
  closed_at         DateTime?       @db.Timestamptz
  turno_id          Int?
  area              Area            @relation(fields: [area_id], references: [id], onDelete: Restrict)
  usuario           Usuario         @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  cadi              Cadi?           @relation(fields: [cadi_id], references: [id], onDelete: SetNull)
  cliente           Cliente?        @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  turno             Turno?          @relation(fields: [turno_id], references: [id], onDelete: SetNull)
  detalleCuentas    DetalleCuenta[]
  divisionesCuentas DivisionCuenta[]

  @@map("cuentas")
}

model DetalleCuenta {
  id              BigInt   @id @default(autoincrement())
  cuenta_id       BigInt
  producto_id     Int
  cantidad        Decimal  @db.Decimal(12, 4)
  precio_unitario Decimal  @db.Decimal(12, 4)
  descuento       Decimal  @default(0.0000) @db.Decimal(12, 4)
  subtotal        Decimal  @db.Decimal(12, 4)
  impuestos       Decimal  @default(0.0000) @db.Decimal(12, 4)
  total           Decimal  @db.Decimal(12, 4)
  estado_item     String   @default("PEDIDO") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamptz
  cuenta          Cuenta   @relation(fields: [cuenta_id], references: [id], onDelete: Cascade)
  producto        Producto @relation(fields: [producto_id], references: [id], onDelete: Restrict)

  @@map("detalle_cuentas")
}

model DivisionCuenta {
  id                       BigInt    @id @default(autoincrement())
  cuenta_id                BigInt
  cliente_id               Int
  porcentaje_participacion Decimal   @db.Decimal(5, 2)
  monto_proporcional       Decimal   @db.Decimal(12, 4)
  metodo_pago              String?   @db.VarChar(50)
  estado_pago              String    @default("PENDIENTE") @db.VarChar(20)
  pagado_at                DateTime? @db.Timestamptz
  cuenta                   Cuenta    @relation(fields: [cuenta_id], references: [id], onDelete: Restrict)
  cliente                  Cliente   @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cuenta_id, cliente_id], name: "uq_cuenta_cliente_division")
  @@map("divisiones_cuentas")
}

model Turno {
  id             Int          @id @default(autoincrement())
  usuario_id     Int
  fondo_inicial  Decimal      @db.Decimal(12, 4)
  caja_efectivo  Decimal      @default(0.0000) @db.Decimal(12, 4)
  caja_tarjeta   Decimal      @default(0.0000) @db.Decimal(12, 4)
  caja_cargos    Decimal      @default(0.0000) @db.Decimal(12, 4)
  abierto_at     DateTime     @default(now()) @db.Timestamptz
  cerrado_at     DateTime?    @db.Timestamptz
  activo         Boolean      @default(true)
  usuario        Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  cuentas        Cuenta[]
  retiros        RetiroCaja[]

  @@map("turnos")
}

model RetiroCaja {
  id          Int      @id @default(autoincrement())
  turno_id    Int
  monto       Decimal  @db.Decimal(12, 4)
  motivo      String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz
  turno       Turno    @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@map("retiros_caja")
}

model Insumo {
  id           Int                 @id @default(autoincrement())
  nombre       String              @unique @db.VarChar(100)
  stock        Decimal             @default(0.0000) @db.Decimal(12, 4)
  unidad       String              @db.VarChar(20)
  stock_minimo Decimal             @default(0.0000) @db.Decimal(12, 4)
  created_at   DateTime            @default(now()) @db.Timestamptz
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz
  recetas      RecetaIngrediente[]

  @@map("insumos")
}

model RecetaIngrediente {
  producto_id Int
  insumo_id   Int
  cantidad    Decimal  @db.Decimal(12, 4)
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  insumo      Insumo   @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@id([producto_id, insumo_id])
  @@map("receta_ingredientes")
}

model GastoIngresoCCL {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @db.Date
  tipo_registro  String   // 'GASTO_FIJO', 'GASTO_VARIABLE', 'GASTO_MATERIAL', 'INGRESO'
  concepto       String
  monto          Decimal  @db.Decimal(12, 4)
  metodo_pago    String   // 'EFECTIVO', 'IZETTLE', 'BANREGIO'
  created_at     DateTime @default(now()) @db.Timestamptz

  @@map("gastos_ingresos_ccl")
}

model IdempotencyKey {
  key             String   @id @db.VarChar(255)
  status          String   @db.VarChar(20) // 'PROCESSING', 'COMPLETED'
  response_status Int?
  response_body   String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("idempotency_keys")
}

